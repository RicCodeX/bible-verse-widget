<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/verse" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="top|start" android:fontFamily="@font/adventor"
        android:textColor="@color/widget_text" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="8dp">
        <TextView android:id="@+id/ref" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="@font/adventor" android:textSize="11sp"
            android:textColor="@color/widget_sub" />
        <TextView android:id="@+id/tr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/adventor" android:textSize="11sp" android:textColor="@color/widget_sub" />
    </LinearLayout>
</LinearLayout>
